
# Terraform provider downloads
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform execution plans
*.tfplan
tfplan

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files containing secrets
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Local Jenkinsfile test backups
Jenkinsfile.rollback-backup
